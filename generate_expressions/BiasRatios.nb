Cell["\<\
-0.07142857142857142*(cn*Power((k1 + k2)/(Power(k1,3)*k2 + \
k1*Power(k2,3)),an)*L2b1*Lb1*
      (Power(k1*k2*(Power(k1,2) + Power(k2,2)),an)*
         (Power(k1,2)*Power(k2,2)*((-12 - 5*an + 7*Power(an,2))*Lb1 - 
              7*(Power(an,2)*Lb2 + 4*an*(Lb2 - 2*Lbs2) - 8*Lbs2)) - 
           2*an*Power(k1,3)*k2*(10*Lb1 + 7*(4 + an)*Lb2 - 14*Lbs2) + 
           an*k1*Power(k2,3)*((8 + 7*an)*Lb1 + 28*Lbs2) - 
           Power(k2,4)*((8 + 7*an)*Lb1 + 28*Lbs2) + 
           Power(k1,4)*(20*Lb1 - 7*(4*an*Lb2 + Power(an,2)*Lb2 + 4*Lbs2))) - 
        (k1 - k2)*Power((k1*k2*(Power(k1,2) + Power(k2,2)))/(k1 + k2),an)*
         ((1 + an)*k1*Power(k2,2)*((8 + 7*an)*Lb1 + 28*Lbs2) + 
           Power(k2,3)*((8 + 7*an)*Lb1 + 28*Lbs2) + 
           Power(k1,3)*(20*Lb1 - 7*(4*an*Lb2 + Power(an,2)*Lb2 + 4*Lbs2)) + 
           Power(k1,2)*k2*(20*(1 + an)*Lb1 + 
              7*(4*an*Lb2 + Power(an,2)*Lb2 - 4*Lbs2 - \
4*an*Lbs2)))*Power(Abs(k1 - k2),an))
      )/(an*(2 + an)*(4 + an)*Power(k1,3)*k2)\
\>", "Output",
