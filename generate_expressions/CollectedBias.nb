Cell["\<\
(Power(b1k1,2)*cn*(-14*(-2 + an)*(6 + an)*b1k2*b2k2*Power(k1,2)*
        (Power(k1 + k2,1 + an)*(20*Power(k1,3) - 20*(1 + an)*Power(k1,2)*k2 + \

             (1 + an)*(8 + 7*an)*k1*Power(k2,2) - (8 + 7*an)*Power(k2,3)) - 
          (k1 - k2)*(20*Power(k1,3) + 20*(1 + an)*Power(k1,2)*k2 + 
             (1 + an)*(8 + 7*an)*k1*Power(k2,2) + (8 + 7*an)*Power(k2,3))*
           Power(Abs(k1 - k2),an)) + 
       b1k2*bs2k2*(-56*Power(k1 + k2,1 + an)*
           (120*Power(k1,5) - 120*(1 + an)*Power(k1,4)*k2 + 
             (1 + an)*(42 + 47*an)*Power(k1,3)*Power(k2,2) - 
             (1 + an)*(42 + an*(9 + 7*an))*Power(k1,2)*Power(k2,3) + 
             3*(1 + an)*(2 + 7*an)*k1*Power(k2,4) - 3*(2 + 7*an)*Power(k2,5)) \
+ 
          56*(k1 - k2)*(120*Power(k1,5) + 120*(1 + an)*Power(k1,4)*k2 + 
             (1 + an)*(42 + 47*an)*Power(k1,3)*Power(k2,2) + 
             (1 + an)*(42 + an*(9 + 7*an))*Power(k1,2)*Power(k2,3) + 
             3*(1 + an)*(2 + 7*an)*k1*Power(k2,4) + 3*(2 + \
7*an)*Power(k2,5))*
           Power(Abs(k1 - k2),an)) + 
       Power(b1k2,2)*(Power(k1 + k2,an)*
           (2400*Power(k1,6) - 2400*an*Power(k1,5)*k2 + 
             360*(-2 + an + 3*Power(an,2))*Power(k1,4)*Power(k2,2) - 
             40*an*(1 + an)*(2 + 7*an)*Power(k1,3)*Power(k2,3) + 
             (-1392 + an*(-340 + an*(478 + 7*an*(30 + \
7*an))))*Power(k1,2)*Power(k2,4) - 
             2*an*(-8 + 7*an)*(18 + 7*an)*k1*Power(k2,5) + 
             2*(-8 + 7*an)*(18 + 7*an)*Power(k2,6)) - 
          (2400*Power(k1,6) + 2400*an*Power(k1,5)*k2 + 
             360*(-2 + an + 3*Power(an,2))*Power(k1,4)*Power(k2,2) + 
             40*an*(1 + an)*(2 + 7*an)*Power(k1,3)*Power(k2,3) + 
             (-1392 + an*(-340 + an*(478 + 7*an*(30 + \
7*an))))*Power(k1,2)*Power(k2,4) + 
             2*an*(-8 + 7*an)*(18 + 7*an)*k1*Power(k2,5) + 
             2*(-8 + 7*an)*(18 + 7*an)*Power(k2,6))*Power(Abs(k1 - k2),an)) + \

       49*(-2 + an)*an*(4 + an)*(6 + an)*Power(b2k2,2)*Power(k1,4)*
        (Power(k1 + k2,2 + an) - Power(Abs(k1 - k2),2 + an)) - 
       392*(-2 + an)*(6 + an)*b2k2*bs2k2*Power(k1,2)*
        (-(Power(k1 + k2,2 + an)*(Power(k1,2) - (2 + an)*k1*k2 + \
Power(k2,2))) + 
          (Power(k1,2) + (2 + an)*k1*k2 + Power(k2,2))*Power(Abs(k1 - k2),2 + \
an)) + 
       1568*Power(bs2k2,2)*(Power(k1 + k2,2 + an)*
           (3*Power(k1,4) - 3*(2 + an)*Power(k1,3)*k2 + 
             (6 + an*(4 + an))*Power(k1,2)*Power(k2,2) - 3*(2 + \
an)*k1*Power(k2,3) + 
             3*Power(k2,4)) - (3*Power(k1,4) + 3*(2 + an)*Power(k1,3)*k2 + 
             (6 + an*(4 + an))*Power(k1,2)*Power(k2,2) + 3*(2 + \
an)*k1*Power(k2,3) + 
             3*Power(k2,4))*Power(Abs(k1 - k2),2 + an))))/
   (392.*(-2 + an)*an*(2 + an)*(4 + an)*(6 + an)*Power(k1,5)*k2)\
\>", "Output",
